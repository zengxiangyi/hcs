<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baogang.info.mapper.TechStepMapper">

    <sql id="Base_Column_List">
        id, firstlevel, secondlevel, step, stepname, sort, isneed, remark
    </sql>

    <!-- 列名无下划线，map-underscore-to-camel-case 不生效，需显式映射 -->
    <resultMap id="TechStepResultMap" type="com.baogang.info.entity.TechStep">
        <id column="id" property="id"/>
        <result column="firstlevel" property="firstLevel"/>
        <result column="secondlevel" property="secondLevel"/>
        <result column="step" property="step"/>
        <result column="stepname" property="stepName"/>
        <result column="sort" property="sort"/>
        <result column="isneed" property="isNeed"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Query_Where">
        <where>
            <if test="q.firstLevel != null and q.firstLevel != ''">AND firstlevel = #{q.firstLevel}</if>
            <if test="q.secondLevel != null and q.secondLevel != ''">AND secondlevel = #{q.secondLevel}</if>
            <if test="q.step != null and q.step != ''">AND step = #{q.step}</if>
            <if test="q.stepName != null and q.stepName != ''">AND stepname LIKE CONCAT('%', #{q.stepName}, '%')</if>
            <if test="q.isNeed != null and q.isNeed != ''">AND isneed = #{q.isNeed}</if>
            <if test="q.remark != null and q.remark != ''">AND remark LIKE CONCAT('%', #{q.remark}, '%')</if>
        </where>
    </sql>

    <select id="query" resultMap="TechStepResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM techstep
        <include refid="Query_Where"/>
        ORDER BY firstlevel, secondlevel, sort + 0
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(1)
        FROM techstep
        <include refid="Query_Where"/>
    </select>

</mapper>
