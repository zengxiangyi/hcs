<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baogang.info.mapper.TaskProcessMapper">

    <sql id="Base_Column_List">
        auditmessage, auditstate, audittime, audituser, blueprint, createtime,
        createuser, id, state, step, transfer, updatetime, updateuser
    </sql>

    <resultMap id="TaskProcessResultMap" type="com.baogang.info.entity.TaskProcess">
        <id column="id" property="id"/>
        <result column="transfer" property="transfer"/>
        <result column="blueprint" property="blueprint"/>
        <result column="audituser" property="auditUser"/>
        <result column="audittime" property="auditTime"/>
        <result column="auditmessage" property="auditMessage"/>
        <result column="auditstate" property="auditState"/>
        <result column="step" property="step"/>
        <result column="state" property="state"/>
        <result column="createuser" property="createUser"/>
        <result column="createtime" property="createTime"/>
        <result column="updateuser" property="updateUser"/>
        <result column="updatetime" property="updateTime"/>
    </resultMap>

    <sql id="Query_Where">
        <where>
            <if test="q.transfer != null and q.transfer != ''">AND transfer = #{q.transfer}</if>
            <if test="q.blueprint != null and q.blueprint != ''">AND blueprint = #{q.blueprint}</if>
            <if test="q.auditUser != null and q.auditUser != ''">AND audituser = #{q.auditUser}</if>
            <if test="q.auditState != null and q.auditState != ''">AND auditstate = #{q.auditState}</if>
            <if test="q.step != null and q.step != ''">AND step = #{q.step}</if>
            <if test="q.state != null and q.state != ''">AND state = #{q.state}</if>
            <if test="q.createUser != null and q.createUser != ''">AND createuser = #{q.createUser}</if>
        </where>
    </sql>

    <select id="query" resultMap="TaskProcessResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM taskprocess
        <include refid="Query_Where"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(1)
        FROM taskprocess
        <include refid="Query_Where"/>
    </select>

</mapper>
